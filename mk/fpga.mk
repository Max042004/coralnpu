# FPGA SoC flows: the full-chip Verilator model and the Vivado (Nexus) builds.
# Port of fpga/BUILD's fusesoc_build targets.
#
#   make chip-verilator VARIANT=vector_normal     -> build/fpga/<variant>/.../Vchip_verilator
#   make chip-verilator-all
#   make chip-nexus VARIANT=matrix_highmem TYPE=synth_only|elab_only|bitstream
#
# The SoC is built from FuseSoC `.core` files because it embeds OpenTitan IP
# whose several hundred cores are FuseSoC-native. Everything *around* FuseSoC is
# plain make: OpenTitan/ISP sources are pinned downloads (below), the Chisel
# subsystem is generated by `make rtl`, and the core search path, flags and
# Verilator options are spelled out here instead of in Bazel rules.

FPGA_BUILD := $(BUILD)/fpga
FUSESOC    ?= $(TOOLS_DIR)/venv/bin/fusesoc

OT_COMMIT  := 0e3cf62211004443d6d29f8f6120882376da499a
OT_SHA256  := 2120eaba3603de3ce4eaf559657fdda640a64c78fb4fbe4e815f5187fe65584e
OT_DIR     := $(DEPS_BUILD)/opentitan

ISP_URL    := https://storage.googleapis.com/shodan-public-artifacts/isp-d53dc0e0ce2605cea2e3b3fc5b97e9dd40f8d55a.tar.gz
ISP_SHA256 := 3a8a976451f7eda0c42d027460ae0b65e485bb9068405b9186eaa991aa740972
ISP_DIR    := $(DEPS_BUILD)/ispyocto

.PHONY: fpga-deps chip-verilator chip-verilator-all chip-nexus

fpga-deps: $(OT_DIR)/.stamp $(ISP_DIR)/.stamp

$(OT_DIR)/.stamp:
	@mkdir -p $(OT_DIR)
	curl -fsSL -o $(DEPS_BUILD)/opentitan.tar.gz https://github.com/lowRISC/opentitan/archive/$(OT_COMMIT).tar.gz
	echo "$(OT_SHA256)  $(DEPS_BUILD)/opentitan.tar.gz" | sha256sum -c -
	tar xzf $(DEPS_BUILD)/opentitan.tar.gz -C $(OT_DIR) --strip-components=1
	rm -f $(DEPS_BUILD)/opentitan.tar.gz
	@touch $@

$(ISP_DIR)/.stamp:
	@mkdir -p $(ISP_DIR)
	curl -fsSL -o $(DEPS_BUILD)/ispyocto.tar.gz $(ISP_URL)
	echo "$(ISP_SHA256)  $(DEPS_BUILD)/ispyocto.tar.gz" | sha256sum -c -
	tar xzf $(DEPS_BUILD)/ispyocto.tar.gz -C $(ISP_DIR)
	rm -f $(DEPS_BUILD)/ispyocto.tar.gz $(ISP_DIR)/ispyocto/BUILD $(ISP_DIR)/axi2sramcrs/BUILD \
	      $(ISP_DIR)/ispyocto/rtl/ispyocto_filelist.txt
	@touch $@

# ---- configuration variants (fpga/BUILD _ALL_CONFIGS) ----
# <variant>:<chisel design>:<fpga/ip dir suffix>:<MHz>:<ITCM KB>:<DTCM KB>:<extra verilator opts>
ISP_MHZ  := 10
SPIM_MHZ := 100
FPGA_VARIANTS := \
  vector_normal:CoralNPUChiselSubsystem:default:50:8:32 \
  vector_highmem:CoralNPUChiselSubsystemHighmem:highmem:50:1024:1024 \
  matrix_normal:CoralNPUChiselSubsystemMatrix:matrix:30:8:32 \
  matrix_highmem:CoralNPUChiselSubsystemMatrixHighmem:matrix_highmem:30:1024:1024

VERILATOR_THREADS ?= $(shell n=$$(nproc); [ $$n -gt 8 ] && n=8; echo $$n)
VLT_COMMON := -Wno-ALWCOMBORDER -Wno-WIDTHEXPAND -Wno-WIDTHTRUNC -Wno-UNUSEDSIGNAL -Wno-UNUSEDPARAM \
              -Wno-VARHIDDEN -Wno-UNOPTTHREADS -Wno-GENUNNAMED -Wno-DECLFILENAME -Wno-ASCRANGE \
              -DRVFI -DUSE_GENERIC -DUSE_DPI_MEMORY -DTB_SUPPORT -DVLEN_128 -DZVE32F_ON \
              -Wno-BLKANDNBLK -Wno-CASEX --no-timing --threads $(VERILATOR_THREADS)
VLT_HIGHMEM := -CFLAGS "-DCHISEL_SUBSYSTEM_HIGHMEM"
VLT_ZVT     := -DZVT_ON

vlt_opts_vector_normal   = $(VLT_COMMON)
vlt_opts_vector_highmem  = $(VLT_HIGHMEM) $(VLT_COMMON)
vlt_opts_matrix_normal   = $(VLT_ZVT) $(VLT_COMMON)
vlt_opts_matrix_highmem  = $(VLT_HIGHMEM) $(VLT_ZVT) $(VLT_COMMON)
zvt_flags_matrix_normal  = --ZVT_ON=true
zvt_flags_matrix_highmem = --ZVT_ON=true

fv_field = $(word $(2),$(subst :, ,$(filter $(1):%,$(FPGA_VARIANTS))))

# The generated Chisel subsystem as a FuseSoC core: copy the SV, instantiate the .core.tpl.
define chisel_core_rule
$(FPGA_BUILD)/cores/$(1)/.stamp: $(BUILD)/rtl/$(2)/$(2).sv fpga/ip/coralnpu_chisel_subsystem_$(3)/coralnpu_chisel_subsystem_$(3).core.tpl
	@mkdir -p $(FPGA_BUILD)/cores/$(1)
	# coralnpu_soc.sv instantiates the subsystem as `CoralNPUChiselSubsystem`, while the Chisel
	# emitter names the highmem/matrix variants after their configuration; rename the top.
	sed 's/^module $(2)(/module CoralNPUChiselSubsystem(/' $(BUILD)/rtl/$(2)/$(2).sv > $(FPGA_BUILD)/cores/$(1)/$(2).sv
	sed 's|__VERILOG_FILE__|$(2).sv|' fpga/ip/coralnpu_chisel_subsystem_$(3)/coralnpu_chisel_subsystem_$(3).core.tpl \
	  > $(FPGA_BUILD)/cores/$(1)/coralnpu_chisel_subsystem_$(3).core
	@touch $$@
endef
$(foreach v,$(FPGA_VARIANTS),$(eval $(call chisel_core_rule,$(word 1,$(subst :, ,$(v))),$(word 2,$(subst :, ,$(v))),$(word 3,$(subst :, ,$(v))))))

# fusesoc <common args> <cores roots>; one build root per variant
FUSESOC_ROOTS = --cores-root=$(OT_DIR)/hw --cores-root=$(ROOT)/fpga --cores-root=$(ROOT)/hdl/verilog \
                --cores-root=$(ISP_DIR)

CHIP_BIN = $(FPGA_BUILD)/$(1)/build/com.google.coralnpu_fpga_chip_verilator_0.1/sim-verilator/Vchip_verilator

define chip_verilator_rule
$(call CHIP_BIN,$(1)): $(FPGA_BUILD)/cores/$(1)/.stamp $(OT_DIR)/.stamp $(ISP_DIR)/.stamp
	@mkdir -p $(FPGA_BUILD)/$(1) $(FPGA_BUILD)/home
	printf '[main]\n  cache_root = $(FPGA_BUILD)/cache\n' > $(FPGA_BUILD)/$(1)/fusesoc.toml
	cd $(ROOT) && HOME=$(FPGA_BUILD)/home PATH=$(dir $(FUSESOC)):$$$$PATH $(FUSESOC) \
	  --config=$(FPGA_BUILD)/$(1)/fusesoc.toml $$(FUSESOC_ROOTS) --cores-root=$(FPGA_BUILD)/cores/$(1) \
	  run --target=sim --setup --build --build-root=$(FPGA_BUILD)/$(1)/build \
	  com.google.coralnpu:fpga:chip_verilator:0.1 \
	  --ClockFrequencyMhz=$(4) --IspClockFrequencyMhz=$$(ISP_MHZ) --SpimClockFrequencyMhz=$(4) \
	  --ItcmSizeKBytes=$(5) --DtcmSizeKBytes=$(6) \
	  --verilator_options="$$(vlt_opts_$(1))" --make_options="-j$$(JOBS)"
endef
$(foreach v,$(FPGA_VARIANTS),$(eval $(call chip_verilator_rule,$(word 1,$(subst :, ,$(v))),$(word 2,$(subst :, ,$(v))),$(word 3,$(subst :, ,$(v))),$(word 4,$(subst :, ,$(v))),$(word 5,$(subst :, ,$(v))),$(word 6,$(subst :, ,$(v))))))

chip-verilator:
ifndef VARIANT
	$(error usage: make chip-verilator VARIANT=<$(foreach v,$(FPGA_VARIANTS),$(word 1,$(subst :, ,$(v))))>)
endif
	$(MAKE) $(call CHIP_BIN,$(VARIANT))

chip-verilator-all: $(foreach v,$(FPGA_VARIANTS),$(call CHIP_BIN,$(word 1,$(subst :, ,$(v)))))

# ---- SoC simulation tests (utils/coralnpu_soc_loader/sim_test_runner.py) ----
include mk/fpga_tests.mk

SOC_STAGE := $(ELF_DIR)/fpga
LOADER_STAGE := $(ELF_DIR)/utils/coralnpu_soc_loader/loader
GREY_RAW := $(ELF_DIR)/fpga/ip/ispyocto/grey_bars_320x240.raw

# The runner looks the simulator up as coralnpu_hw/fpga/Vchip_verilator[_highmem]:
# the non-highmem one is the 50 MHz vector build, the highmem one the 30 MHz matrix build.
$(SOC_STAGE)/Vchip_verilator: $(call CHIP_BIN,vector_normal)
	@mkdir -p $(dir $@) && cp $< $@
$(SOC_STAGE)/Vchip_verilator_highmem: $(call CHIP_BIN,matrix_highmem)
	@mkdir -p $(dir $@) && cp $< $@

# `loader` was a py_binary.
$(LOADER_STAGE): utils/coralnpu_soc_loader/loader.py
	@mkdir -p $(dir $@)
	printf '#!/bin/sh\nPYTHONPATH=$(ROOT)/utils/coralnpu_soc_loader:$(ROOT):$$PYTHONPATH exec $(PYTHON) $(ROOT)/utils/coralnpu_soc_loader/loader.py "$$@"\n' > $@
	chmod +x $@

$(GREY_RAW): fpga/ip/ispyocto/dv/camera_model/gen_test_pattern.py
	@mkdir -p $(dir $@)
	cd $(dir $@) && $(PYTHON) $(ROOT)/fpga/ip/ispyocto/dv/camera_model/gen_test_pattern.py && mv test_pattern_320x240.raw grey_bars_320x240.raw

define fpga_sim_test_rule
.PHONY: fpga-sim-test-$(1)
fpga-sim-test-$(1): $(ELF_DIR)/$($(1)_ELF).elf $(SOC_STAGE)/Vchip_verilator$(if $(filter 1,$($(1)_HIGHMEM)),_highmem) $(LOADER_STAGE) $(GREY_RAW)
	@mkdir -p $(FPGA_BUILD)/run/$(1)
	cd $(FPGA_BUILD)/run/$(1) && CORALNPU_RUNFILES=$(ELF_DIR) CORALNPU_ROOT=$(ROOT) \
	  PYTHONPATH=$(ROOT)/utils/pyshim:$(ROOT)/utils/coralnpu_soc_loader:$(ROOT) \
	  $(PYTHON) $(ROOT)/utils/coralnpu_soc_loader/sim_test_runner.py $(ELF_DIR)/$($(1)_ELF).elf \
	  --sim_timeout $($(1)_TIMEOUT) $(if $(filter 1,$($(1)_HIGHMEM)),--highmem) \
	  --itcm_size_kbytes $($(1)_ITCM) --dtcm_size_kbytes $($(1)_DTCM) --loader=$($(1)_LOADER)
endef
$(foreach t,$(FPGA_SIM_TESTS),$(eval $(call fpga_sim_test_rule,$(t))))

.PHONY: fpga-sim-tests list-fpga-sim-tests
list-fpga-sim-tests:
	@printf '%s\n' $(FPGA_SIM_TESTS)
fpga-sim-tests: $(addprefix fpga-sim-test-,$(FPGA_SIM_TESTS))

# ---- Vivado (Nexus board) builds: bitstream | synth_only | elab_only ----
# Needs Vivado on PATH (VIVADO_BIN) and, for bitstreams, the board's licence. DDR uses the
# open stub core; add a proprietary DDR IP by putting its cores on the search path
# (NEXUS_EXTRA_ROOTS) and listing them in NEXUS_EXTRA_CORES.
VIVADO_BIN ?= /tools/Xilinx/Vivado/2019.2/bin
TYPE ?= synth_only
NEXUS_EXTRA_ROOTS ?=
NEXUS_EXTRA_CORES ?=
NEXUS_CLK_SPIM := $(SPIM_MHZ)

nexus_target = $(if $(filter elab_only,$(TYPE)),elab,synth)
nexus_pnr    = $(if $(filter synth_only elab_only,$(TYPE)),--pnr=none)

# One variant per invocation: make chip-nexus VARIANT=vector_normal TYPE=elab_only
#   bitstream  : fusesoc synth + place & route
#   synth_only : fusesoc synth, --pnr=none
#   elab_only  : fusesoc project setup only, then `synth_design -rtl` in Vivado batch mode
NEXUS_SYSTEM := com.google.coralnpu:fpga:chip_nexus:0.1
NEXUS_SYSDIR := com.google.coralnpu_fpga_chip_nexus_0.1
nexus_dir = $(FPGA_BUILD)/nexus_$(VARIANT)_$(TYPE)
nexus_fusesoc = cd $(ROOT) && HOME=$(FPGA_BUILD)/home PATH=$(dir $(FUSESOC)):$(VIVADO_BIN):$$PATH $(FUSESOC) \
  --config=$(nexus_dir)/fusesoc.toml $(FUSESOC_ROOTS) \
  --cores-root=$(FPGA_BUILD)/cores/$(VARIANT) $(addprefix --cores-root=,$(NEXUS_EXTRA_ROOTS)) \
  run --target=synth --setup $(if $(filter elab_only,$(TYPE)),,--build) \
  --build-root=$(nexus_dir)/build $(NEXUS_SYSTEM) \
  --ClockFrequencyMhz=$(call fv_field,$(VARIANT),4) --IspClockFrequencyMhz=$(ISP_MHZ) \
  --SpimClockFrequencyMhz=$(NEXUS_CLK_SPIM) \
  --ItcmSizeKBytes=$(call fv_field,$(VARIANT),5) --DtcmSizeKBytes=$(call fv_field,$(VARIANT),6) \
  $(zvt_flags_$(VARIANT)) $(nexus_pnr)

chip-nexus: $(FPGA_BUILD)/cores/$(VARIANT)/.stamp $(OT_DIR)/.stamp $(ISP_DIR)/.stamp
ifndef VARIANT
	$(error usage: make chip-nexus VARIANT=<variant> [TYPE=bitstream|synth_only|elab_only])
endif
	@mkdir -p $(nexus_dir) $(FPGA_BUILD)/home
	printf '[main]\n  cache_root = $(FPGA_BUILD)/cache\n' > $(nexus_dir)/fusesoc.toml
	$(nexus_fusesoc)
ifeq ($(TYPE),elab_only)
	cd $(nexus_dir)/build/$(NEXUS_SYSDIR)/synth-vivado && \
	  printf '%s\n' 'source $(NEXUS_SYSDIR).tcl' \
	    'if {[catch {synth_design -rtl -name rtl_1} err]} { puts "ERROR: Elaboration failed: $$err"; exit 1 }' \
	    'puts "=== VIVADO RTL ELABORATION COMPLETED SUCCESSFULLY ==="' > run_elab.tcl && \
	  HOME=$(FPGA_BUILD)/home PATH=$(VIVADO_BIN):$$PATH vivado -notrace -mode batch -source run_elab.tcl
endif
